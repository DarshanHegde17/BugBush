# ==============================================================================
# BugBash Platform - Environment Configuration (.env)
# ==============================================================================

# Application Environment (development, test, production)
ENVIRONMENT=development

# Application Base URLs
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:8000

# Security
JWT_SECRET=super_secret_bugbash_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# MongoDB Connection (Persistent database visible in MongoDB Compass)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bugbash

# ==============================================================================
# Real Email Delivery Configuration (Gmail SMTP, SendGrid, Amazon SES, etc.)
# ==============================================================================
# To send REAL verification emails to actual candidate inboxes:
# 1. For Gmail:
#    - Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
#    - Generate an App Password: https://myaccount.google.com/apppasswords (select "Mail" and "Windows Computer")
#    - Enter your Gmail address in SMTP_USER and your 16-character App Password in SMTP_PASSWORD below.
#
# If SMTP_USER and SMTP_PASSWORD are left blank, BugBash operates in local development
# mode: the 6-digit OTP code is displayed on-screen in the helper banner and printed
# directly to the terminal console, so you can test registration without SMTP setup.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@bugbash.com
SMTP_FROM_NAME=BugBash Security
SMTP_USE_TLS=true
