# Application Configuration
APP_NAME=BugBash
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bugbash_db

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Redis / Celery / Message Broker (Optional)
REDIS_URL=redis://localhost:6379/0

